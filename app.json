{
  "expo": {
    "name": "MyStoneINN",
    "slug": "mystoneinn-mobile",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mystoneinn",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f6f9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mystoneinn.admin",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Uygulamaya Face ID ile giriş yapmak için kullanılır.",
        "NSCameraUsageDescription": "Kimlik ve oda fotoğrafı için kamera erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Kimlik ve oda fotoğrafı için galeri erişimi gerekir."
      }
    },
    "android": {
      "package": "com.mystoneinn.admin",
      "versionCode": 8,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f4f6f9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulamaya Face ID ile giriş yapmak için kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6B7B4C",
          "defaultChannel": "default"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "meta": {
        "viewport": "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
      }
    },
    "extra": {
      "siteUrl": "https://mystoneinn.com"
    }
  }
}
